{
  "version": 1,
  "about": "Debrief flag rules: language-agnostic regexes over added and removed diff lines. code_only rules ignore string contents and comments. Override per project in <archive>/projects/<id>/rules.json.",
  "rules": [
    {
      "id": "loop",
      "category": "critical",
      "kind": "loop",
      "severity": "medium",
      "on": "added",
      "pattern": "^\\s*(?:(?:do\\s*)?while\\b|for\\s*\\(\\s*;\\s*;\\s*\\)|for\\s*\\{|loop\\s*\\{|until\\b)",
      "message": "New loop. Declare it as a critical path with its termination invariant.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/*.json",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc"
      ],
      "code_only": true
    },
    {
      "id": "retry",
      "category": "critical",
      "kind": "retry",
      "severity": "high",
      "on": "added",
      "pattern": "(?i)\\b(?:retry|retries|retrying|backoff|max_?attempts|with_retries|tenacity|exponential)\\b",
      "message": "Retry or backoff logic. Declare it as a critical path: what bounds the attempts?",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "sleep",
      "category": "critical",
      "kind": "retry",
      "severity": "medium",
      "on": "added",
      "pattern": "\\b(?:time\\.sleep|asyncio\\.sleep|Thread\\.sleep|usleep|nanosleep|tokio::time::sleep|std::this_thread::sleep_for)\\s*\\(|\\bsleep\\s+\\d",
      "message": "Sleep or timer. Often part of a retry or polling loop that needs an invariant.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "concurrency",
      "category": "critical",
      "kind": "concurrency",
      "severity": "high",
      "on": "added",
      "pattern": "\\b(?:threading\\.|Thread\\(|Lock\\(|RLock\\(|Semaphore\\(|Condition\\(|Mutex\\b|RwLock\\b|synchronized\\b|flock\\b|fcntl\\.|multiprocessing\\.|ThreadPool|ProcessPool|concurrent\\.futures|asyncio\\.(?:gather|create_task|Lock|Queue)|std::thread|std::mutex|pthread_\\w+|Atomic\\w+|WaitGroup|chan\\s+\\w|go\\s+func\\b|go\\s+\\w+\\()",
      "message": "Concurrency construct. Declare it as a critical path with what it protects.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "external-io",
      "category": "critical",
      "kind": "external-io",
      "severity": "medium",
      "on": "added",
      "pattern": "\\b(?:requests\\.(?:get|post|put|patch|delete|request|Session)|urllib\\.request|urlopen|http\\.client|HTTPConnection|fetch\\(|axios\\.|XMLHttpRequest|subprocess\\.(?:run|Popen|call|check_output|check_call)|os\\.system|os\\.popen|exec\\.Command|socket\\.socket|grpc\\.\\w+channel|net\\.Dial|reqwest::|Command::new)",
      "message": "External call (network or subprocess). Declare it as a critical path: timeouts and failure handling.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "error-handling",
      "category": "critical",
      "kind": "error-handling",
      "severity": "low",
      "on": "added",
      "pattern": "^\\s*(?:except\\b|}?\\s*catch\\s*[({]|rescue\\b|recover\\(\\)|on\\s+\\w+\\s+catch\\b)",
      "message": "New error handling. Declare it as a critical path: what is caught and what happens next.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "broad-except",
      "category": "risky",
      "severity": "medium",
      "on": "added",
      "pattern": "^\\s*except\\s*(?:\\(?\\s*(?:Exception|BaseException)\\b[^:]*)?:|catch\\s*\\(\\s*(?:Exception|Throwable|\\.\\.\\.|std::exception\\s*&?\\s*\\w*)\\s*\\w*\\s*\\)|catch\\s*\\(\\s*\\w+\\s*\\)\\s*\\{\\s*\\}",
      "message": "Broad exception catch. Narrow it or say why everything must be caught.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "swallowed-error",
      "category": "risky",
      "severity": "high",
      "on": "added",
      "pattern": "except[^:]*:\\s*(?:pass|\\.\\.\\.)\\s*(?:#.*)?$|catch\\s*(?:\\([^)]*\\))?\\s*\\{\\s*\\}|if\\s+err\\s*!=\\s*nil\\s*\\{\\s*\\}|\\.catch\\(\\s*\\(\\s*\\w*\\s*\\)\\s*=>\\s*\\{\\s*\\}\\s*\\)",
      "message": "Error silently swallowed.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "todo",
      "category": "risky",
      "severity": "low",
      "on": "added",
      "pattern": "\\b(?:TODO|FIXME|XXX|HACK)\\b",
      "message": "Added TODO or FIXME.",
      "exclude": [
        "**/*.md",
        "**/*.json"
      ]
    },
    {
      "id": "stub",
      "category": "risky",
      "severity": "medium",
      "on": "added",
      "pattern": "raise\\s+NotImplementedError|\\btodo!\\(|\\bunimplemented!\\(|throw\\s+new\\s+(?:Error|UnsupportedOperationException|NotImplementedException)\\(\\s*['\\\"](?i:not\\s+implemented)|panic\\(\\s*\\\"(?i:not\\s+implemented|todo)",
      "message": "Stub or not-implemented placeholder.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "dependency-change",
      "category": "risky",
      "severity": "medium",
      "on": "any",
      "pattern": "\\S",
      "paths": [
        "**/requirements*.txt",
        "**/pyproject.toml",
        "**/setup.py",
        "**/setup.cfg",
        "**/Pipfile",
        "**/package.json",
        "**/go.mod",
        "**/Cargo.toml",
        "**/Gemfile",
        "**/pom.xml",
        "**/build.gradle",
        "**/build.gradle.kts",
        "**/MODULE.bazel",
        "**/WORKSPACE",
        "**/WORKSPACE.bazel",
        "**/deps.bzl",
        "**/repositories.bzl",
        "**/conanfile.*",
        "**/vcpkg.json",
        "**/environment.yml"
      ],
      "message": "Dependency manifest changed: check what was added and why.",
      "once_per_file": true
    },
    {
      "id": "config-change",
      "category": "risky",
      "severity": "low",
      "on": "any",
      "pattern": "\\S",
      "paths": [
        "**/*.ini",
        "**/*.cfg",
        "**/*.conf",
        "**/.env",
        "**/.env.*",
        "**/*.properties",
        "**/config/**",
        "**/*.config.js",
        "**/*.config.ts",
        "**/.bazelrc",
        "**/Dockerfile",
        "**/*.tf"
      ],
      "message": "Configuration changed.",
      "once_per_file": true
    },
    {
      "id": "feature-flag",
      "category": "risky",
      "severity": "low",
      "on": "added",
      "pattern": "(?i)\\b(?:feature_?flags?|is_enabled\\(|FLAGS\\.\\w+|DEFINE_(?:bool|string|int|integer|float)|absl\\.flags|launchdarkly|unleash)\\b",
      "message": "Feature flag or command-line flag added or changed.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "suppression",
      "category": "risky",
      "severity": "low",
      "on": "added",
      "pattern": "#\\s*noqa|#\\s*type:\\s*ignore|eslint-disable|@ts-ignore|@ts-expect-error|@SuppressWarnings|//\\s*nolint|#\\[allow\\(|#\\s*pylint:\\s*disable|NOLINT",
      "message": "Lint or type check suppressed.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/*.json"
      ]
    },
    {
      "id": "unsafe-call",
      "category": "risky",
      "severity": "high",
      "on": "added",
      "pattern": "verify\\s*=\\s*False|InsecureSkipVerify\\s*:\\s*true|shell\\s*=\\s*True|\\beval\\(|pickle\\.loads?\\(|yaml\\.load\\((?![^)]*Loader=yaml\\.SafeLoader)|rejectUnauthorized\\s*:\\s*false|dangerouslySetInnerHTML|innerHTML\\s*=",
      "message": "Potentially unsafe call: TLS verification off, shell or eval, unsafe deserialization or raw HTML.",
      "exclude": [
        "**/*.md",
        "**/*.txt",
        "**/*.rst",
        "**/LICENSE*",
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc",
        "**/*.json"
      ],
      "code_only": true
    },
    {
      "id": "assertion-removed",
      "category": "test",
      "severity": "high",
      "on": "removed",
      "pattern": "\\b(?:assert\\w*|self\\.assert\\w+|expect\\(|EXPECT_\\w+|ASSERT_\\w+|assertEquals|assertThat|t\\.(?:Error|Errorf|Fatal|Fatalf)\\(|require\\.\\w+\\(|should\\.\\w+)",
      "message": "Assertion removed from a test.",
      "paths": [
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc"
      ],
      "code_only": true
    },
    {
      "id": "test-skipped",
      "category": "test",
      "severity": "high",
      "on": "added",
      "pattern": "@pytest\\.mark\\.(?:skip|xfail)|@unittest\\.skip|\\.skipTest\\(|\\b(?:it|describe|test)\\.(?:skip|todo)\\(|\\bx(?:it|describe|test)\\(|t\\.Skip(?:f|Now)?\\(|@Disabled\\b|@Ignore\\b|#\\[ignore\\]|\\bDISABLED_\\w+|GTEST_SKIP",
      "message": "Test skipped or disabled.",
      "paths": [
        "**/test_*.py",
        "**/*_test.py",
        "**/tests/**",
        "**/test/**",
        "**/*_test.go",
        "**/*.test.*",
        "**/*.spec.*",
        "**/__tests__/**",
        "**/*Test.java",
        "**/*Tests.java",
        "**/*Test.kt",
        "**/*Tests.cs",
        "**/*_spec.rb",
        "**/*_test.cc",
        "**/*_unittest.cc"
      ],
      "code_only": true
    }
  ]
}
